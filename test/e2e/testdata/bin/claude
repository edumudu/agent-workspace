#!/bin/sh
# why: usage: fake Claude Code for the e2e suite. It replays $AGENTWS_E2E/<harness>.steps
# one line at a time, firing the hooks the real harness would:
#   hook <Event> [json]   pipe json (default {}) to `agentws hook`
#   run <shell>           run a command as the Bash tool: PreToolUse, the command, PostToolUse
#   gate <name>           block until $AGENTWS_E2E/gates/<name> exists (30 s cap, twice the scripts' 15 s polling so a gate never gives up first)
#   read <file>           take what is typed into the pane into $AGENTWS_E2E/<file>
# After the last step it stays alive, holding its pane like a real agent.
harness=${AGENTWS_E2E_HARNESS:-claude}
steps="$AGENTWS_E2E/$harness.steps"

# why: `agentws hook` drops an event it cannot send within its 50 ms budget and
# logs one line to $AGENTWS_HOME/hook.log. A loaded CI runner can stall the hook
# that long, and these scripts test the state machine, not that budget, so an
# event that never left is fired again (5 tries in all, each retry noted in the
# harness log). A late reply ("no reply within") means the event was sent, so it
# is not fired again.
hook() {
	payload=$2
	[ -n "$payload" ] || payload='{}'
	log="$AGENTWS_HOME/hook.log"
	try=0
	while :; do
		before=$(cat "$log" 2>/dev/null | wc -l)
		printf '%s' "$payload" | agentws hook --harness "$harness" --event "$1"
		after=$(cat "$log" 2>/dev/null | wc -l)
		[ "$after" -gt "$before" ] || return 0
		last=$(tail -n 1 "$log")
		case $last in *"no reply within"*) return 0 ;; esac
		try=$((try + 1))
		[ "$try" -lt 5 ] || return 0
		echo "hook $1 dropped ($last), firing again" >>"$AGENTWS_E2E/$harness.log"
	done
}

tool_payload() {
	cmd=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')
	printf '{"cwd":"%s","tool_name":"Bash","tool_input":{"command":"%s"}}' "$PWD" "$cmd"
}

gate() {
	i=0
	while [ ! -e "$AGENTWS_E2E/gates/$1" ]; do
		i=$((i + 1))
		if [ "$i" -gt 1500 ]; then
			echo "gate $1 never opened" >>"$AGENTWS_E2E/$harness.log"
			exit 1
		fi
		sleep 0.02
	done
}

exec 3<"$steps"
while IFS= read -r line <&3; do
	verb=${line%% *}
	rest=${line#"$verb"}
	rest=${rest# }
	case $verb in
	hook)
		event=${rest%% *}
		json=${rest#"$event"}
		hook "$event" "${json# }"
		;;
	run)
		hook PreToolUse "$(tool_payload "$rest")"
		sh -c "$rest" >>"$AGENTWS_E2E/$harness.log" 2>&1
		hook PostToolUse "$(tool_payload "$rest")"
		;;
	gate) gate "$rest" ;;
	read)
		stty -echo
		exec cat >"$AGENTWS_E2E/$rest"
		;;
	esac
done
exec tail -f /dev/null
