#!/bin/sh
# why: usage: fake terminal-notifier so the suite never posts a real macOS banner.
# Each call appends its argv, tab separated, as one line of
# $AGENTWS_E2E/terminal-notifier.log.
for arg in "$@"; do
	printf '%s\t' "$arg"
done >>"$AGENTWS_E2E/terminal-notifier.log"
echo >>"$AGENTWS_E2E/terminal-notifier.log"
