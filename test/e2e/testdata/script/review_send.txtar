# Review comments on 2 files are sent, and the agent receives exactly the
# documented prompt (internal/domain/testdata/review_prompt.golden).
repo api
exec agentws workspace add api
exec agentws new --workspace api 'write two files'
capture SID '^session (\S+) on pane'
eventually ' state=done ' agentws debug session --once $SID
exec agentws worktree list
capture WT '^(\S+)\s+\S+\s+'$SID'\s'

exec agentws review comment --session $SID --file $WT/notes.txt --start 2 --code two --body 'Say three.'
stdout '^comment \S+ on notes.txt:2 \(1 in the draft\)$'
exec agentws review comment --session $SID --file $WT/main.go --start 1 --code 'package main' --body 'Add a main func.'
stdout '\(2 in the draft\)$'
exec agentws review send --session $SID
stdout '^sent 2 comments to '$SID'$'
eventually 'Add a main func\.\n\z' cat $AGENTWS_E2E/received
cmpenv $AGENTWS_E2E/received want.txt

-- claude.steps --
hook UserPromptSubmit {"prompt":"write two files"}
run printf 'one\ntwo\n' > notes.txt
run printf 'package main\n\n' > main.go
hook Stop {"last_assistant_message":"Wrote them."}
read received
-- want.txt --
Review comments on your changes. Each one names the worktree, file and lines it is about; make the edit in that worktree.

1. $WT:notes.txt:2
   > two
   Say three.

2. $WT:main.go:1
   > package main
   Add a main func.
