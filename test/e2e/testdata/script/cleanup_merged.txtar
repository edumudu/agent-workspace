# The fake gh marks one PR merged. The next cleanup removes only that
# worktree, and keeps its branch. The daemon's cleanup clock runs 2 h ahead
# (AGENTWS_TEST_CLOCK), past the 1 h activity grace.
repo api
exec agentws workspace add api
exec agentws new --workspace api 'ship two parts'
capture SID '^session (\S+) on pane'
eventually ' state=done ' agentws debug session --once $SID
mkdir $AGENTWS_E2E/gates/end
eventually ' state=idle ' agentws debug session --once $SID
eventually '/api-b\s+feat-b\s+'$SID'\s' agentws worktree list
capture A '^(\S+/api-a)\s'

cp prs-merged.json prs.json
eventually '/api-a\s+feat-a\s+'$SID'\s+#7 merged' agentws worktree list
exec agentws cleanup
! exists $A
exists $A/../api-b
exec git -C api branch --list feat-a
stdout 'feat-a'
exec agentws worktree list
! stdout '/api-a\s'
stdout '/api-b\s+feat-b\s+'$SID'\s'
grep 'feat-a' $AGENTWS_HOME/cleanup.log

-- claude.steps --
hook UserPromptSubmit {"prompt":"ship two parts"}
run git worktree add -q -b feat-a ../api-a && cd ../api-a && echo a > a.txt && git add a.txt && git commit -qm a
run git worktree add -q -b feat-b ../api-b && cd ../api-b && echo b > b.txt && git add b.txt && git commit -qm b
hook Stop
gate end
hook SessionEnd
-- prs-merged.json --
{"data":{"r0":{"pullRequests":{"nodes":[
  {"number":7,"title":"Part a","url":"https://github.com/o/api/pull/7","headRefName":"feat-a","state":"MERGED",
   "reviewDecision":"APPROVED","mergeable":"UNKNOWN",
   "reviewThreads":{"nodes":[]},"comments":{"nodes":[]},"reviews":{"nodes":[]},"commits":{"nodes":[]}}]}}}}
