#!/usr/bin/env bash
# Runs the PR's added and changed *_test.go files against the base branch.
# They must fail there (a compile error counts); if any affected package
# passes, the PR added tests for behavior that already exists.
# Usage: scripts/tdd-check <base-ref> <head-ref>
set -euo pipefail
base="$1"
head="$2"

files=$(git diff --name-only --diff-filter=AM "$base...$head" -- '*_test.go')
if [ -z "$files" ]; then
  echo "tdd: no added or changed test files"
  exit 0
fi

git checkout --quiet --detach "$base"
# shellcheck disable=SC2086
git checkout "$head" -- $files

pkgs=$(for f in $files; do echo "./$(dirname "$f")"; done | sort -u)
passed=()
for pkg in $pkgs; do
  echo "tdd: go test $pkg on base"
  if go test -count=1 "$pkg"; then
    passed+=("$pkg")
  fi
done

if [ ${#passed[@]} -gt 0 ]; then
  echo "tdd: FAIL. These tests pass on the base branch, so they don't cover new behavior: ${passed[*]}"
  exit 1
fi
echo "tdd: ok, every new or changed test fails on base"
