#!/usr/bin/env bash
# why: Usage: scripts/tdd-check <base-ref> <head-ref>. Port fakes
# (fakes_test.go, *_fake_test.go) and changes that carry no behavior (see
# changed_tests) are skipped: they have nothing to fail on base. The "test:" title comes
# in TDD_PR_TITLE, an env var, so it is never interpolated into a command line.
# why: "fails on base" can't tell whether the test came first, so every
# non-merge commit is also checked: one that changes tests may not change
# production code too, unless its subject starts with "refactor:" or "refactor(". Markdown
# carries no behavior, so it never counts as production code here.
set -euo pipefail
base="$1"
head="$2"

is_test_path() {
  case "$1" in
    (*_test.go | testdata/* | */testdata/* | test/*) return 0 ;;
    (*) return 1 ;;
  esac
}

non_test_paths() {
  git diff --name-only -z --no-renames "$base...$head" | while IFS= read -r -d '' f; do
    is_test_path "$f" || echo "$f"
  done
}

title="${TDD_PR_TITLE:-}"
case "$title" in
  (test:*)
    offending=$(non_test_paths)
    if [ -z "$offending" ]; then
      echo "tdd: ok, test-only PR titled test: is exempt"
      exit 0
    fi
    echo "tdd: a test: PR is exempt only when it changes no production code; these files are not tests:"
    echo "$offending"
    echo "tdd: running the normal check; retitle the PR or split the production change out"
    ;;
esac

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# why: whitespace and comments in a Go test carry no behavior, but whitespace
# inside a string literal does, so Go files are compared token by token with
# go/scanner rather than with git diff's whitespace and line-regex options.
same_go_tokens() {
  if [ ! -x "$tmp/sametokens" ]; then
    mkdir -p "$tmp/sametokens.src"
    printf 'module sametokens\n\ngo 1.22\n' >"$tmp/sametokens.src/go.mod"
    cat >"$tmp/sametokens.src/main.go" <<'GO'
package main

import (
	"go/scanner"
	"go/token"
	"os"
	"slices"
)

func tokens(path string) []string {
	src, err := os.ReadFile(path)
	if err != nil {
		os.Exit(2)
	}
	file := token.NewFileSet().AddFile(path, -1, len(src))
	var s scanner.Scanner
	bad := false
	s.Init(file, src, func(token.Position, string) { bad = true }, 0)
	var out []string
	for {
		_, tok, lit := s.Scan()
		if tok == token.EOF {
			break
		}
		if tok == token.SEMICOLON {
			lit = ""
		}
		out = append(out, tok.String()+" "+lit)
	}
	if bad {
		os.Exit(1)
	}
	return out
}

func main() {
	if !slices.Equal(tokens(os.Args[1]), tokens(os.Args[2])) {
		os.Exit(1)
	}
}
GO
    (cd "$tmp/sametokens.src" && GOWORK=off GOFLAGS= go build -o "$tmp/sametokens" .)
  fi
  git show "$1" >"$tmp/old.go"
  git show "$2" >"$tmp/new.go"
  "$tmp/sametokens" "$tmp/old.go" "$tmp/new.go"
}

# why: compares commit $1 with commit $2 and fills two arrays: changed (test
# files that carry a change, at their new path) and removed (test paths gone in
# $2: the old path of a rename, or a deleted file, which git reports instead of
# a rename when a moved test was rewritten). The base run removes them so an
# old copy can't collide with the new one.
# In goldens and lint-comments fixtures a comment-shaped line is expected
# output or linter input, so only whitespace amount is ignored there.
changed_tests() {
  local old="$1" new="$2" status from to
  changed=()
  removed=()
  while IFS= read -r -d '' status; do
    IFS= read -r -d '' from
    to="$from"
    case "$status" in
    (R*) IFS= read -r -d '' to ;;
    (D) removed+=("$from"); continue ;;
    esac
    case "$to" in (fakes_test.go | */fakes_test.go | *_fake_test.go) continue ;; esac
    if [ "$status" != A ]; then
      case "$to" in
      (*.go)
        ! same_go_tokens "$old:$from" "$new:$to" || continue ;;
      (*.golden | *.go.txt)
        ! git diff --quiet --ignore-space-change --ignore-blank-lines "$old:$from" "$new:$to" || continue ;;
      (*)
        ! git diff --quiet --ignore-space-change --ignore-blank-lines -I '^[[:space:]]*(//|#)' "$old:$from" "$new:$to" || continue ;;
      esac
    fi
    changed+=("$to")
    [ "$from" = "$to" ] || removed+=("$from")
  done < <(git diff --name-status -z -M --diff-filter=AMRD "$old" "$new" -- '*_test.go' '*/testdata/*')
}

mixed=0
while IFS= read -r c; do
  subject=$(git log -1 --format=%s "$c")
  case "$subject" in (refactor:* | refactor\(*) continue ;; esac
  changed_tests "$c^" "$c"
  [ ${#changed[@]} -gt 0 ] || continue
  prod=$(git diff-tree --no-commit-id -r --name-only -z --no-renames "$c" | while IFS= read -r -d '' f; do
    case "$f" in (*.md) continue ;; esac
    is_test_path "$f" || echo "$f"
  done)
  [ -n "$prod" ] || continue
  echo "tdd: commit $(git log -1 --format='%h %s' "$c") changes tests and production code together:"
  # shellcheck disable=SC2086
  printf "  %s\n" "${changed[@]}" $prod
  mixed=1
done < <(git rev-list --no-merges --reverse "$base..$head")
if [ "$mixed" -ne 0 ]; then
  echo "tdd: FAIL. Commit each failing test on its own, before the commit that makes it pass."
  exit 1
fi

changed_tests "$(git merge-base "$base" "$head")" "$head"
if [ ${#changed[@]} -eq 0 ]; then
  echo "tdd: no added or changed test files or testdata (port fakes, whitespace-only and comment-only changes are exempt)"
  exit 0
fi

git checkout --quiet --detach "$base"
git checkout "$head" -- "${changed[@]}"
for f in ${removed[@]+"${removed[@]}"}; do
  rm -f "$f"
done

pkgs=$(for f in "${changed[@]}"; do
  case "$f" in
    (*/testdata/*) echo "./${f%%/testdata/*}" ;;
    (*) echo "./$(dirname "$f")" ;;
  esac
done | sort -u)
passed=()
for pkg in $pkgs; do
  echo "tdd: go test $pkg on base"
  if go test -count=1 -tags integration "$pkg"; then
    passed+=("$pkg")
  fi
done

if [ ${#passed[@]} -gt 0 ]; then
  echo "tdd: FAIL. These tests pass on the base branch, so they don't cover new behavior: ${passed[*]}"
  exit 1
fi
echo "tdd: ok, every new or changed test fails on base"
