#!/usr/bin/env bash
# Runs the PR's added and changed *_test.go and testdata/ files against the
# base branch; a testdata file counts for the package that holds testdata/.
# They must fail there (a compile error counts); if any affected package
# passes, the PR added tests for behavior that already exists.
# Files named fakes_test.go or *_fake_test.go are skipped: they only hold
# in-memory fakes of ports, which change when a port gains a method.
# Usage: scripts/tdd-check <base-ref> <head-ref>
set -euo pipefail
base="$1"
head="$2"

files=$(git diff --name-only --diff-filter=AM "$base...$head" -- '*_test.go' '*/testdata/*' |
  grep -Ev '(^|/)(fakes|[^/]*_fake)_test\.go$' || true)
if [ -z "$files" ]; then
  echo "tdd: no added or changed test files or testdata (port fake files are exempt)"
  exit 0
fi

git checkout --quiet --detach "$base"
# shellcheck disable=SC2086
git checkout "$head" -- $files

pkgs=$(for f in $files; do
  case "$f" in
    (*/testdata/*) echo "./${f%%/testdata/*}" ;;
    (*) echo "./$(dirname "$f")" ;;
  esac
done | sort -u)
passed=()
for pkg in $pkgs; do
  echo "tdd: go test $pkg on base"
  if go test -count=1 -tags integration "$pkg"; then
    passed+=("$pkg")
  fi
done

if [ ${#passed[@]} -gt 0 ]; then
  echo "tdd: FAIL. These tests pass on the base branch, so they don't cover new behavior: ${passed[*]}"
  exit 1
fi
echo "tdd: ok, every new or changed test fails on base"
