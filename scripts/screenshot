#!/usr/bin/env bash
# why: usage: scripts/screenshot <out.png> [COLSxROWS] < steps
# Runs a command in a throwaway tmux server against a throwaway daemon, plays
# the steps from stdin, and renders the pane, colors included, to a PNG with
# freeze (go install github.com/charmbracelet/freeze@latest). Steps, one a line:
#   run <command...>   start it in the pane (default: agentws tui --new-session)
#   type <text>        send the text literally
#   key <tmux key>...  send keys by tmux name (Tab, Enter, Left, BSpace, ...)
#   wait <seconds>     sleep
#   shot <out.png>     render now; the final render goes to <out.png> from argv
# The command runs with AGENTWS_LAUNCH_DIR set to the cwd, so ./ means this checkout.
set -euo pipefail
out="$1"
size="${2:-100x32}"
root="$(cd "$(dirname "$0")/.." && pwd)"
bin="$root/bin/agentws"
make -C "$root" build >/dev/null
freeze="$(command -v freeze || echo "$(go env GOPATH)/bin/freeze")"
# why: macOS caps Unix socket paths at 104 bytes, so the home must be short.
home="$(mktemp -d /tmp/aws-shot.XXXXXX)"
sock="aws-shot-$$"
export AGENTWS_HOME="$home" AGENTWS_TMUX_SOCKET="$sock-agents"
trap '{ tmux -L "$sock" kill-server; "$bin" daemon stop; tmux -L "$sock-agents" kill-server; rm -rf "$home"; } >/dev/null 2>&1 || true' EXIT
"$bin" daemon start >/dev/null
tmux -L "$sock" -f /dev/null new-session -d -s shot -x "${size%x*}" -y "${size#*x}" -c "$PWD"
tmux -L "$sock" set -g status off

render() {
  tmux -L "$sock" capture-pane -e -p -t shot | "$freeze" --language ansi --window=false --padding 20 --output "$1" >/dev/null
  echo "wrote $1"
}

started=0
# why: the pane's shell re-splits the line, so every word is quoted, and only a
# word that is exactly agentws becomes the built binary (paths that contain it stay).
start() {
  local words=() w
  for w in "$@"; do
    if [ "$w" = agentws ]; then words+=("$bin"); else words+=("$w"); fi
  done
  tmux -L "$sock" send-keys -t shot "$(printf '%q ' env "AGENTWS_HOME=$home" "AGENTWS_TMUX_SOCKET=$sock-agents" "AGENTWS_LAUNCH_DIR=$PWD" "${words[@]}")" Enter
  started=1
  sleep 1.5
}

while IFS= read -r line || [ -n "$line" ]; do
  verb="${line%% *}"
  arg="${line#"$verb"}"
  arg="${arg# }"
  if [ "$started" = 0 ] && [ "$verb" != run ]; then
    start "$bin" tui --new-session
  fi
  case "$verb" in
  # shellcheck disable=SC2086
  run) start $arg ;;
  type) tmux -L "$sock" send-keys -t shot -l "$arg"; sleep 0.5 ;;
  # shellcheck disable=SC2086
  key) tmux -L "$sock" send-keys -t shot $arg; sleep 0.5 ;;
  wait) sleep "$arg" ;;
  shot) render "$arg" ;;
  "") ;;
  *) echo "screenshot: unknown step: $line" >&2; exit 2 ;;
  esac
done
[ "$started" = 1 ] || start "$bin" tui --new-session
render "$out"
