#!/usr/bin/env bash
set -euo pipefail
gremlins="${1:-gremlins}"
for pkg in internal/domain internal/app; do
  if ! ls "$pkg"/*_test.go >/dev/null 2>&1; then
    echo "mutate: $pkg has no tests yet, skipping"
    continue
  fi
  GOMAXPROCS=4 "$gremlins" unleash --workers 2 --threshold-efficacy 80 "./$pkg"
done
